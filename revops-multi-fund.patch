@@ -0,0 +1,237 @@
+"""Daily portfolio snapshot persistence (JSON per day under data/snapshots/)."""
+
+from __future__ import annotations
+
+import json
+from datetime import date, datetime, timezone
+from pathlib import Path
+from typing import Any
+
+from utils.config import HOLDINGS, HOLDINGS_AS_OF, SNAPSHOTS_DIR
+
+
+def ensure_snapshots_dir(path: Path | None = None) -> Path:
+    root = path or SNAPSHOTS_DIR
+    root.mkdir(parents=True, exist_ok=True)
+    return root
+
+
+def snapshot_path(as_of: date | str, path: Path | None = None) -> Path:
+    root = ensure_snapshots_dir(path)
+    if isinstance(as_of, date):
+        day = as_of.isoformat()
+    else:
+        day = str(as_of)[:10]
+    return root / f"{day}.json"
+
+
+def build_snapshot_from_holdings(
+    holdings: list[dict[str, Any]] | None = None,
+    *,
+    as_of: date | None = None,
+    nav_overrides: dict[str, float] | None = None,
+    source: str = "config",
+) -> dict[str, Any]:
+    """
+    Build a snapshot payload from HOLDINGS (optionally overriding NAVs).
+
+    Value for each holding = units * nav (rounded to 2 decimals for INR).
+    """
+    day = as_of or HOLDINGS_AS_OF
+    rows: list[dict[str, Any]] = []
+    overrides = nav_overrides or {}
+    for holding in holdings or HOLDINGS:
+        hid = holding["id"]
+        units = float(holding["units"])
+        if hid in overrides:
+            nav = float(overrides[hid])
+        else:
+            nav = float(holding.get("snapshot_nav") or holding.get("nav") or 0.0)
+        value = round(units * nav, 2)
+        rows.append(
+            {
+                "id": hid,
+                "name": holding["name"],
+                "short_name": holding.get("short_name") or holding["name"],
+                "category": holding.get("category"),
+                "units": units,
+                "nav": round(nav, 4),
+                "value": value,
+                "nav_source": holding.get("nav_source"),
+                "scheme_code": holding.get("scheme_code"),
+            }
+        )
+    total = round(sum(r["value"] for r in rows), 2)
+    return {
+        "as_of": day.isoformat() if isinstance(day, date) else str(day)[:10],
+        "created_at": datetime.now(timezone.utc).isoformat(),
+        "source": source,
+        "currency": "INR",
+        "total_value": total,
+        "holdings": rows,
+    }
+
+
+def save_snapshot(
+    snapshot: dict[str, Any],
+    path: Path | None = None,
+    *,
+    overwrite: bool = True,
+) -> Path:
+    """Persist a snapshot as data/snapshots/YYYY-MM-DD.json."""
+    as_of = snapshot.get("as_of")
+    if not as_of:
+        raise ValueError("snapshot must include as_of (YYYY-MM-DD).")
+    dest = snapshot_path(as_of, path)
+    if dest.exists() and not overwrite:
+        return dest
+    ensure_snapshots_dir(dest.parent)
+    dest.write_text(json.dumps(snapshot, indent=2, sort_keys=False) + "\n", encoding="utf-8")
+    return dest
+
+
+def load_snapshot(as_of: date | str, path: Path | None = None) -> dict[str, Any] | None:
+    dest = snapshot_path(as_of, path)
+    if not dest.exists():
+        return None
+    return json.loads(dest.read_text(encoding="utf-8"))
+
+
+def list_snapshots(path: Path | None = None) -> list[dict[str, Any]]:
+    """Return snapshots sorted by as_of ascending (oldest first)."""
+    root = ensure_snapshots_dir(path)
+    out: list[dict[str, Any]] = []
+    for file in sorted(root.glob("*.json")):
+        try:
+            payload = json.loads(file.read_text(encoding="utf-8"))
+        except (json.JSONDecodeError, OSError):
+            continue
+        if "as_of" not in payload:
+            payload["as_of"] = file.stem
+        out.append(payload)
+    out.sort(key=lambda s: s.get("as_of") or "")
+    return out
+
+
+def latest_snapshot(path: Path | None = None) -> dict[str, Any] | None:
+    snaps = list_snapshots(path)
+    return snaps[-1] if snaps else None
+
+
+def day_over_day_change(
+    path: Path | None = None,
+    *,
+    as_of: date | str | None = None,
+) -> dict[str, Any] | None:
+    """
+    Compare the given (or latest) snapshot to the previous one.
+
+    Returns total delta + per-holding deltas, or None if < 2 snapshots.
+    """
+    snaps = list_snapshots(path)
+    if len(snaps) < 2:
+        return None
+
+    if as_of is None:
+        current = snaps[-1]
+        previous = snaps[-2]
+    else:
+        day = as_of.isoformat() if isinstance(as_of, date) else str(as_of)[:10]
+        idx = next((i for i, s in enumerate(snaps) if s.get("as_of") == day), None)
+        if idx is None or idx == 0:
+            return None
+        current = snaps[idx]
+        previous = snaps[idx - 1]
+
+    prev_by_id = {h["id"]: h for h in previous.get("holdings") or []}
+    holding_deltas: list[dict[str, Any]] = []
+    for row in current.get("holdings") or []:
+        prev = prev_by_id.get(row["id"])
+        prev_value = float(prev["value"]) if prev else None
+        curr_value = float(row["value"])
+        delta = None if prev_value is None else round(curr_value - prev_value, 2)
+        pct = None
+        if prev_value and prev_value != 0 and delta is not None:
+            pct = round((delta / prev_value) * 100.0, 4)
+        holding_deltas.append(
+            {
+                "id": row["id"],
+                "name": row.get("short_name") or row.get("name"),
+                "previous_value": prev_value,
+                "current_value": curr_value,
+                "delta": delta,
+                "delta_pct": pct,
+            }
+        )
+
+    prev_total = float(previous.get("total_value") or 0.0)
+    curr_total = float(current.get("total_value") or 0.0)
+    total_delta = round(curr_total - prev_total, 2)
+    total_pct = round((total_delta / prev_total) * 100.0, 4) if prev_total else None
+
+    return {
+        "previous_as_of": previous.get("as_of"),
+        "current_as_of": current.get("as_of"),
+        "previous_total": prev_total,
+        "current_total": curr_total,
+        "delta": total_delta,
+        "delta_pct": total_pct,
+        "holdings": holding_deltas,
+    }
+
+
+def seed_baseline_snapshot(
+    path: Path | None = None,
+    *,
+    overwrite: bool = False,
+) -> Path:
+    """Write the committed seed snapshot for HOLDINGS_AS_OF if missing."""
+    existing = load_snapshot(HOLDINGS_AS_OF, path)
+    if existing is not None and not overwrite:
+        return snapshot_path(HOLDINGS_AS_OF, path)
+    # Use exact config snapshot_value fields (not recomputed) for the seed.
+    rows = []
+    for holding in HOLDINGS:
+        rows.append(
+            {
+                "id": holding["id"],
+                "name": holding["name"],
+                "short_name": holding.get("short_name") or holding["name"],
+                "category": holding.get("category"),
+                "units": float(holding["units"]),
+                "nav": float(holding["snapshot_nav"]),
+                "value": float(holding["snapshot_value"]),
+                "nav_source": holding.get("nav_source"),
+                "scheme_code": holding.get("scheme_code"),
+            }
+        )
+    snapshot = {
+        "as_of": HOLDINGS_AS_OF.isoformat(),
+        "created_at": "2026-09-06T00:00:00+05:30",
+        "source": "seed",
+        "currency": "INR",
+        "total_value": round(sum(r["value"] for r in rows), 2),
+        "holdings": rows,
+        "notes": (
+            "Baseline seed snapshot (Asia/Kolkata). "
+            "NPS/ULIP use manual NAV; Kotak scheme 149182 refreshes via mfapi."
+        ),
+    }
+    return save_snapshot(snapshot, path, overwrite=True)
+
+
+def snapshots_to_history_df(path: Path | None = None):
+    """Return a pandas DataFrame of Date + Portfolio Value from snapshots."""
+    import pandas as pd
+
+    rows = []
+    for snap in list_snapshots(path):
+        rows.append(
+            {
+                "Date": pd.Timestamp(snap["as_of"]),
+                "Portfolio Value": float(snap.get("total_value") or 0.0),
+            }
+        )
+    if not rows:
+        return pd.DataFrame(columns=["Date", "Portfolio Value"])
+    return pd.DataFrame(rows).sort_values("Date").reset_index(drop=True)
